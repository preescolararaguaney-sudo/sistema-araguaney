NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secreta — solo en el servidor, nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Bot de Telegram para recibir capture de pagos (se crea con @BotFather).
TELEGRAM_BOT_TOKEN=
# Texto largo y aleatorio que tú inventas: Telegram lo manda en cada llamada
# al webhook y así se distingue de cualquiera que adivine la URL.
TELEGRAM_WEBHOOK_SECRET=
# IDs de Telegram autorizados a mandar capture, separados por coma. Si no los
# sabes, escríbele al bot: responde "Tu ID de Telegram es ...".
TELEGRAM_ALLOWED_USER_IDS=

# Lee los capture con IA (API de Anthropic).
ANTHROPIC_API_KEY=
# Opcional. Por defecto claude-opus-5-5.
ANTHROPIC_MODEL=
# Opcional. URL base del sistema para los enlaces que manda el bot.
APP_URL=
